APP_NAME=Rumah Tumbuh
APP_ENV=development
SECRET_KEY=ganti_dengan_secret_acak_minimal_32_karakter
OTP_ENABLED=true
OTP_ON_LOGIN=false
REMEMBER_ME_ENABLED=true
OTP_DEV_MODE=false

# MySQL Laragon
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=akuntansi_app
DB_USER=root
DB_PASSWORD=

# Preset 1: Mailpit lokal
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_USE_AUTH=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@rumah-tumbuh.local
SMTP_FROM_NAME=Rumah Tumbuh
SMTP_REPLY_TO=
SMTP_TIMEOUT=15

# Preset 2: hosting/domain sendiri (ubah nilai sesuai penyedia)
# SMTP_HOST=smtp.domainku.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USE_AUTH=true
# SMTP_USER=noreply@domainku.com
# SMTP_PASSWORD=kata_sandi_smtp
# SMTP_FROM_EMAIL=noreply@domainku.com

# Preset 3: layanan transaksional (Brevo/SendGrid/Mailgun/SES/Resend)
